@page
@model KlubSportowy.Areas.Identity.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Zmień hasło";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/editData.css" rel="stylesheet" />

<h2>Zmień hasło</h2>

<div class="changePassword">
    <form method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Input.CurrentPassword">Obecne hasło</label>
            <input asp-for="Input.CurrentPassword" class="form-control" />
            <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.NewPassword">Nowe hasło</label>
            <input asp-for="Input.NewPassword" class="form-control" />
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.ConfirmPassword">Powtórz nowe hasło</label>
            <input asp-for="Input.ConfirmPassword" class="form-control" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit">Zmień hasło</button>
</form>
</div>
