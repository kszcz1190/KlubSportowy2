@page
@model KlubSportowy.Areas.Identity.Pages.Account.ChangeEmailModel
@{
    ViewData["Title"] = "Zmień e-mail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/css/editData.css" rel="stylesheet" />
<h2>Zmień e-mail</h2>
<div class="changeEmail"> 
    <form method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Input.NewEmail"> Nowy email</label>
            <input asp-for="Input.NewEmail" class="form-control" />
            <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.Password">Hasło</label>
            <input asp-for="Input.Password" class="form-control" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Zmień e-mail</button>
    </form>
</div>