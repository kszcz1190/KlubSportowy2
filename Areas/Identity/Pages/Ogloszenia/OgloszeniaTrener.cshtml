@page
@model KlubSportowy.Areas.Identity.Pages.Ogloszenia.OgloszeniaTrenerModel
@{
    ViewData["Title"] = "Ogloszenia Trener";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/ads.css" rel="stylesheet" />
<div id="container_ogloszeniaTrener">
    <form method="post">
        <div class="titleAds">
            <label>TREŚĆ: </label>
            <textarea asp-for="ogloszeniaVM.Tresc" required rows="1" cols="70"></textarea>
        </div>
        <br />
        <label>Data wygaśnięcia:</label>
        <input asp-for="ogloszeniaVM.DataUsunieciaOgloszenia" type="date" required />

       <button type="submit" id="buttonOgloszenie">WYŚLIJ</button>
    </form>
</div>
