@page
@model KlubSportowy.Models.MeczModel

@{
    ViewData["Title"] = "Create New Mecz";
}

<h2>Create New Mecz</h2>

<!-- Form to create a new Mecz -->
<form asp-controller="MeczModels" asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Druzyna" class="control-label"></label>
        <input asp-for="Druzyna" class="form-control" />
        <span asp-validation-for="Druzyna" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DruzynaPrzeciwna" class="control-label"></label>
        <input asp-for="DruzynaPrzeciwna" class="form-control" />
        <span asp-validation-for="DruzynaPrzeciwna" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="GoleDruzyna" class="control-label"></label>
        <input asp-for="GoleDruzyna" class="form-control" type="number" />
        <span asp-validation-for="GoleDruzyna" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="GoleDruzynaPrzeciwna" class="control-label"></label>
        <input asp-for="GoleDruzynaPrzeciwna" class="form-control" type="number" />
        <span asp-validation-for="GoleDruzynaPrzeciwna" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IloscZoltychKartekDruzyna" class="control-label"></label>
        <input asp-for="IloscZoltychKartekDruzyna" class="form-control" type="number" />
        <span asp-validation-for="IloscZoltychKartekDruzyna" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IloscZoltychKartekDruzynaPrzeciwna" class="control-label"></label>
        <input asp-for="IloscZoltychKartekDruzynaPrzeciwna" class="form-control" type="number" />
        <span asp-validation-for="IloscZoltychKartekDruzynaPrzeciwna" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IloscCzerwonychKartekDruzyna" class="control-label"></label>
        <input asp-for="IloscCzerwonychKartekDruzyna" class="form-control" type="number" />
        <span asp-validation-for="IloscCzerwonychKartekDruzyna" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IloscCzerwonychKartekDruzynaPrzeciwna" class="control-label"></label>
        <input asp-for="IloscCzerwonychKartekDruzynaPrzeciwna" class="form-control" type="number" />
        <span asp-validation-for="IloscCzerwonychKartekDruzynaPrzeciwna" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

