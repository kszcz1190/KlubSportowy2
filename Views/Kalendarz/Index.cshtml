@{
    ViewData["Title"] = "Kalendarz";
}

<h1>@ViewData["Title"]</h1>

<div id="calendar"></div>
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>

<style>
    #calendar {
        max-width: 900px;
        margin: 0 auto;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',  // Widok kalendarza
            events: '/Kalendarz/GetWydarzenia',  // Wczytaj wydarzenia z endpointu
            eventClick: function (info) {
                alert('Wydarzenie: ' + info.event.title + '\nOpis: ' + info.event.extendedProps.description);
            }
        });

        // Renderowanie kalendarza
        calendar.render();
    });
</script>
