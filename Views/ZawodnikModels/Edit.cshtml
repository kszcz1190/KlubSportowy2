@model KlubSportowy.Models.ZawodnikModel

@{
    ViewData["Title"] = "Edit";
}
<link href="~/css/myStats.css" rel="stylesheet" />
<div id="container_statystyki">
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Imie" class="control-label"></label>
                <input asp-for="Imie" class="form-control" />
                <span asp-validation-for="Imie" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Nazwisko" class="control-label"></label>
                <input asp-for="Nazwisko" class="form-control" />
                <span asp-validation-for="Nazwisko" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Wiek" class="control-label"></label>
                <input asp-for="Wiek" class="form-control" />
                <span asp-validation-for="Wiek" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Kraj" class="control-label"></label>
                <input asp-for="Kraj" class="form-control" />
                <span asp-validation-for="Kraj" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Pozycja" class="control-label"></label>
                <input asp-for="Pozycja" class="form-control" />
                <span asp-validation-for="Pozycja" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LacznaIloscGoli" class="control-label"></label>
                <input asp-for="LacznaIloscGoli" class="form-control" />
                <span asp-validation-for="LacznaIloscGoli" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LacznaIloscZoltychKartek" class="control-label"></label>
                <input asp-for="LacznaIloscZoltychKartek" class="form-control" />
                <span asp-validation-for="LacznaIloscZoltychKartek" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LacznaIloscCzerwonychKartek" class="control-label"></label>
                <input asp-for="LacznaIloscCzerwonychKartek" class="form-control" />
                <span asp-validation-for="LacznaIloscCzerwonychKartek" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LacznaIloscMeczyRozegranych" class="control-label"></label>
                <input asp-for="LacznaIloscMeczyRozegranych" class="form-control" />
                <span asp-validation-for="LacznaIloscMeczyRozegranych" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LacznaIloscMinutRozegranych" class="control-label"></label>
                <input asp-for="LacznaIloscMinutRozegranych" class="form-control" />
                <span asp-validation-for="LacznaIloscMinutRozegranych" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NumerZawodnika" class="control-label"></label>
                <input asp-for="NumerZawodnika" class="form-control" />
                <span asp-validation-for="NumerZawodnika" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ApplicationUserId" class="control-label"></label>
                <select asp-for="ApplicationUserId" class="form-control" asp-items="ViewBag.ApplicationUserId"></select>
                <span asp-validation-for="ApplicationUserId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
