@model IEnumerable<KlubSportowy.Models.PrzedmiotModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CenaPrzedmiotu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IloscPrzedmiotu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NazwaPrzedmiotu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OpisPrzedmiotu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CzyDostepny)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CenaPrzedmiotu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IloscPrzedmiotu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NazwaPrzedmiotu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OpisPrzedmiotu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CzyDostepny)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
