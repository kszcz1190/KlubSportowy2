@using Microsoft.AspNetCore.Identity
@using KlubSportowy.Areas.Identity.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentPath = Context.Request.Path;
    var userRoles = new List<string>();

    if (User.Identity.IsAuthenticated)
    {
        var user = UserManager.GetUserAsync(User).Result; // Uzyskujemy użytkownika, tylko jeśli jest zalogowany
        if (user != null)
        {
            userRoles = UserManager.GetRolesAsync(user).Result.ToList(); // Uzyskujemy role użytkownika
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KlubSportowy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KlubSportowy.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="d-flex justify-content-between align-items-center p-3">
        <div>
            @if (SignInManager.IsSignedIn(User))
            {
                <a id="manage" href="@Url.Action("RedirectToZawodnik", "ProfileRedirect")">
                    @UserManager.GetUserName(User)?.FirstOrDefault()
                </a>
            }
        </div>

        <h1 class="logo text-center">KLUB SPORTOWY</h1>

        <div>
            @if (SignInManager.IsSignedIn(User))
            {
                <form id="logoutForm" class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button id="logout" type="submit" class="btn btn-link">Wyloguj</button>
                </form>
            }
        </div>
    </header>

    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <ul class="navbar-nav">
                @if (User.Identity.IsAuthenticated)
                {
                    @* Wyświetlanie nawigacji dla zawodnika *@
                    @if (userRoles.Contains("Zawodnik"))
                    {
                        <li class="nav-item"><a asp-controller="OgloszeniaZawodnik" asp-action="Index" class="nav-link">OGŁOSZENIA</a></li>
                        <li class="nav-item"><a asp-controller="StatystykiZawodnikaMeczModels" asp-action="Index" class="nav-link">STATYSTYKI</a></li>
                        <li class="nav-item"><a asp-controller="Kalendarz" asp-action="Index" class="nav-link">KALENDARZ</a></li>
                    }
                    @* Wyświetlanie nawigacji dla trenera *@
                    else if (userRoles.Contains("Trener"))
                    {
                        <li class="nav-item"><a asp-area="Identity" asp-page="/Ogloszenia/OgloszeniaTrener" class="nav-link">DODAJ OGŁOSZENIE</a></li>
                        <li class="nav-item"><a asp-area="Identity" asp-page="/Account/Register" class="nav-link">DODAJ UŻYTKOWNIKA</a></li>
                        <li class="nav-item"><a asp-controller="ZawodnikModels" asp-action="Index" class="nav-link">STATYSTYKI ZAWODNIK</a></li>
                        <li class="nav-item"><a asp-controller="MeczModels" asp-action="Index" class="nav-link">STATYSTYKI MECZ</a></li>
                        <li class="nav-item"><a asp-controller="StatystykiZawodnikaMeczModels" asp-action="Index" class="nav-link">STATYSTYKI ZAWODNIKA MECZ</a></li>
                        <li class="nav-item"><a asp-controller="WydarzenieModels" asp-action="Index" class="nav-link">DODAJ WYDARZENIE</a></li>
                        <li class="nav-item"><a asp-controller="Sklep" asp-action="Index" class="nav-link">SKLEP</a></li>
                        <li class="nav-item"><a asp-controller="Kalendarz" asp-action="Index" class="nav-link">KALENDARZ</a></li>
                    }
                }
                else
                {
                    <li class="nav-item"><a asp-controller="Kalendarz" asp-action="Index" class="nav-link">KALENDARZ</a></li>
                    <li class="nav-item"><a asp-area="Identity" asp-page="/Account/Login" class="nav-link">ZALOGUJ SIĘ</a></li>
                }
            </ul>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
