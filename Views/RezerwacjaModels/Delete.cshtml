@model KlubSportowy.Models.RezerwacjaModel

@{
    ViewData["Title"] = "Delete";
}
<link href="~/css/wydarzenia.css" rel="stylesheet" />
<div class="container_dodajWydarzenie">
<h3>Na pewno chcesz usunąć rezerwację? </h3>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.applicationUser)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.applicationUser.Id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.przedmiotModel)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.przedmiotModel.Id)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
