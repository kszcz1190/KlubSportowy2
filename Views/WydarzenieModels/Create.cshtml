@model KlubSportowy.Models.WydarzenieModel

@{
    ViewData["Title"] = "Create";
}
<link href="~/css/wydarzenia.css" rel="stylesheet" />
<div class="container_dodajWydarzenie">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="DataWydarzenia" class="control-label">Data wydarzenia</label>
                <input asp-for="DataWydarzenia" class="form-control" />
                <span asp-validation-for="DataWydarzenia" class="text-danger"></span>
            </div>
            <div class="form-group">
                    <label asp-for="TypWydarzenia" class="control-label">Typ wydarzenia (np. mecz, trening)</label>
                <input asp-for="TypWydarzenia" class="form-control" />
                <span asp-validation-for="TypWydarzenia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="OpisWydarzenia" class="control-label">Opis</label>
                <input asp-for="OpisWydarzenia" class="form-control" />
                <span asp-validation-for="OpisWydarzenia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MiejsceWydarzenia" class="control-label">Miejsce</label>
                <input asp-for="MiejsceWydarzenia" class="form-control" />
                <span asp-validation-for="MiejsceWydarzenia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NazwaWydarzenia" class="control-label">Nazwa wydarzenia</label>
                <input asp-for="NazwaWydarzenia" class="form-control" />
                <span asp-validation-for="NazwaWydarzenia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MeczModelId" class="control-label"></label>
                <select asp-for="MeczModelId" class ="form-control" asp-items="ViewBag.MeczModelId"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>

    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
